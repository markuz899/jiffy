{
  "manifest_version": 3,
  "name": "Jiffy",
  "short_name": "Jiffy",
  "version": "1.1.0",
  "description": "Your open Jira tickets, one click away.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jiffy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.atlassian.net/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "jiffy@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
